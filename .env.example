# Fine-grained PAT with Issues: Read + Write on the target repo
GITHUB_TOKEN=ghp_your_token_here

# Target fork in owner/repo format, e.g. samujala/superset
GITHUB_REPO=owner/repo

# ── Orchestrator ──────────────────────────────────────────────────────────────

# Bearer token for Devin's API (https://app.devin.ai/settings/api-keys)
DEVIN_API_KEY=your_devin_api_key_here

# Devin API base URL — override for testing
DEVIN_API_BASE=https://api.devin.ai/v1

# How often to poll GitHub for new auto-remediable issues (seconds)
POLL_INTERVAL_GITHUB_SECONDS=60

# How often to poll running Devin sessions (seconds)
POLL_INTERVAL_DEVIN_SECONDS=30

# Maximum number of concurrent Devin sessions
MAX_CONCURRENT_SESSIONS=3

# Per-session timeout in seconds (default: 30 minutes)
SESSION_TIMEOUT_SECONDS=1800

# When true, log prompts but don't call Devin's API
DEVIN_DRY_RUN=false

# ── Dashboard API ─────────────────────────────────────────────────────────────

# Path to SQLite database (read-only for the API)
DB_PATH=data/findings.db

# Port the FastAPI server listens on
API_PORT=8000

# Allowed CORS origin for the dashboard
DASHBOARD_ORIGIN=http://localhost:3000
